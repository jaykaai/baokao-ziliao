---
import BaseLayout from '../layouts/BaseLayout.astro'
import FaqSection from '../components/FaqSection.astro'
import MaterialChecklist from '../components/MaterialChecklist.astro'
import { BRAND, MATERIAL_TEMPLATES, YEAR } from '../config/site.js'

const title = `${YEAR}京考报名材料清单：应届/社会人员/留学回国/京外生源`
const description = `按身份分类整理报名常备材料清单：应届毕业生、社会人员、留学回国、京外生源，可对照勾选准备。`

const faqs = [
  {
    q: '这个清单和官方要求完全一致吗？',
    a: '本清单根据常见情况整理，覆盖了大部分考生需要准备的材料。但不同岗位可能有特殊要求，请以《北京市公务员考试录用公告》及报考指南的官方要求为准。'
  },
  {
    q: '清单里没有的材料就不用准备吗？',
    a: '不一定。部分岗位（如公安、法检）会有额外要求（如体能测评表、法律职业资格证书等），请仔细阅读你所报岗位的具体要求。'
  },
  {
    q: '勾选状态会保存吗？换手机还在吗？',
    a: '勾选状态保存在当前浏览器的本地存储里，不换浏览器、不清缓存就一直在。换手机或清缓存后需要重新勾选。'
  },
  {
    q: '材料顺序有要求吗？',
    a: '建议按官方清单的顺序排列合成 PDF，审核人员看起来最顺。顺序不对也是常见驳回原因之一。'
  }
]
---

<BaseLayout title={title} description={description} path="/material-checklist">
  <div class="article-head">
    <h1>京考报名材料清单：按身份对照准备</h1>
    <p class="article-meta">
      数据与「{BRAND}」小程序内的模板一致 · 可勾选，状态自动保存
    </p>
  </div>

  <div class="prose">
    <p>
      京考报名需要上传的材料因身份而异。应届毕业生、社会人员、留学回国人员、京外生源各自需要的材料不同。
      下面按身份分类整理，<strong>点击即可勾选</strong>，方便对照准备，避免遗漏。
    </p>

    <div class="callout">
      <p class="callout-title">重要提示</p>
      <p>
        以上为根据常见情况整理的参考清单，<strong>报名要求请以官方公告为准</strong>。
        「{BRAND}」小程序内的模板与本清单一致，可自由增删改。
      </p>
    </div>

    <MaterialChecklist />

    <h2>准备材料的注意事项</h2>
    <ol class="steps">
      <li><strong>拍原件，不拍屏幕/复印件</strong>，避免摩尔纹和模糊被驳回。</li>
      <li><strong>按清单顺序排列</strong>，合成 PDF 时顺序与官方一致。</li>
      <li><strong>关键信息清晰可读</strong>：身份证号、公章、签字放大后必须能看清。</li>
      <li><strong>控制单 PDF ≤ 3M</strong>，多张材料合成时注意分配每张画质。</li>
    </ol>

    <p>
      材料怎么拍成一个 PDF？看《<a href="/photos-to-pdf">多张材料照片合成一个 PDF</a>》。
      如果之前被驳回过，先对照《<a href="/reject-checklist">常见驳回原因自查表</a>》排查。
    </p>
  </div>

  <FaqSection faqs={faqs} />
</BaseLayout>
