---
/**
 * FaqSection.astro —— 同时渲染可视化 FAQ 区块 + FAQPage JSON-LD
 */
import FaqJsonLd from './FaqJsonLd.astro'

interface Props {
  faqs: { q: string; a: string }[]
  title?: string
}
const { faqs, title = '常见问题' } = Astro.props
---

<FaqJsonLd faqs={faqs} />

<section class="faq">
  <h2>{title}</h2>
  {faqs.map((f) => (
    <div class="faq-item">
      <p class="faq-q">{f.q}</p>
      <p class="faq-a">{f.a}</p>
    </div>
  ))}
</section>
