---
/**
 * HowToJsonLd.astro —— 输出 HowTo 结构化数据
 * 用于教程类页面（/compress-photo、/photos-to-pdf）。
 */
interface Props {
  name: string
  description: string
  steps: string[]
}
const { name, description, steps } = Astro.props

const data = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name,
  description,
  step: steps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `步骤 ${i + 1}`,
    text
  }))
}
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
